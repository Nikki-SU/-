{
  "name": "quiz-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export && node scripts/fix-paths.js",
    "web:deploy": "gh-pages -d dist",
    "web:publish": "npm run web:build && npm run web:deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "expo": "~50.0.0",
    "expo-file-system": "~16.0.0",
    "expo-status-bar": "~1.11.0",
    "jszip": "^3.10.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.4",
    "react-native-safe-area-context": "4.8.2",
    "react-native-web": "~0.19.6",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "gh-pages": "^6.3.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
